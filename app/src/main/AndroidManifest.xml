<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Wi-Fi адаптеры: обычные сетевые соединения -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Bluetooth адаптеры. До Android 12 нужны старые разрешения,
         начиная с Android 12 — новые. Объявлены оба набора. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.bluetooth"
        android:required="false" />

    <!-- USB-адаптеры через кабель OTG. required="false" — телефон без
         поддержки хоста тоже должен уметь поставить приложение. -->
    <uses-feature android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- Read-only мост для DashGrid. Обычное разрешение: данные — текущие
         показания датчиков, без истории, VIN и управления адаптером. -->
    <permission
        android:name="io.github.nchalexz.aaperfmon.permission.READ_TELEMETRY"
        android:protectionLevel="normal" />
    <uses-permission android:name="io.github.nchalexz.aaperfmon.permission.READ_TELEMETRY" />

    <application
        android:name=".AapmApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VagDiag">

        <!-- Журнал производительности отдаётся только явным «Поделиться»:
             FileProvider открывает узкий каталог diagnostics, не весь кэш. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name=".bridge.TelemetryProvider"
            android:authorities="io.github.nchalexz.aaperfmon.telemetry"
            android:exported="true"
            android:readPermission="io.github.nchalexz.aaperfmon.permission.READ_TELEMETRY" />

        <receiver
            android:name=".widget.TelemetryWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/telemetry_widget_info" />
        </receiver>

        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_config_title"
            android:theme="@style/Theme.VagDiag" />

        <service
            android:name=".telemetry.TelemetryService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.VagDiag" />

        <activity
            android:name=".cockpit.CockpitActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:screenOrientation="sensor"
            android:theme="@style/Theme.VagDiag" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="sensor"
            android:theme="@style/Theme.VagDiag">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Телефон сам предложит открыть приложение, когда в кабель OTG
                 воткнут адаптер. Заодно Android выдаёт доступ к устройству
                 без отдельного запроса — так меньше окон перед пользователем. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_adapters" />
        </activity>
    </application>
</manifest>

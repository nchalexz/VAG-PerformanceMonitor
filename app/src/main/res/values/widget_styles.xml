<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetSlotLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/widget_dim</item>
        <item name="android:textSize">9sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>
    <style name="WidgetSlotValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="WidgetSlotUnit">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/widget_dim</item>
        <item name="android:textSize">9sp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="WidgetSlotLabelSmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/widget_dim</item>
        <item name="android:textSize">8sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>
    <style name="WidgetSlotValueSmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="WidgetSlotUnitSmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/widget_dim</item>
        <item name="android:textSize">8sp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="WidgetSlotBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">3dp</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:max">100</item>
        <item name="android:progressDrawable">@drawable/widget_bar</item>
    </style>
</resources>
